{
	"name": "node-library",
	"private": true,
	"version": "0.0.0",
	"description": "Your awesome node library",
	"keywords": [],
	"homepage": "https://github.com/unional/monorepo-template",
	"bugs": {
		"url": "https://github.com/unional/monorepo-template/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/unional/monorepo-template.git",
		"directory": "packages/node-library"
	},
	"license": "MIT",
	"author": {
		"name": "Homa Wong (unional)",
		"email": "homawong@gmail.com",
		"url": "https://github.com/unional"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"import": {
				"types": "./esm/index.d.ts",
				"default": "./esm/index.js"
			},
			"require": {
				"types": "./cjs/index.d.ts",
				"default": "./cjs/index.js"
			}
		}
	},
	"main": "./cjs/index.js",
	"module": "./esm/index.js",
	"types": "./cjs/index.d.ts",
	"files": [
		"cjs",
		"esm",
		"ts",
		"!**/*.{spec,unit,test,accept,integrate,system,pref,stress}.*"
	],
	"scripts": {
		"build": "tsdown",
		"build:watch": "tsdown --watch",
		"clean": "rimraf cjs esm coverage --glob *.tsbuildinfo",
		"coverage": "vitest run --coverage",
		"depcheck": "depcheck",
		"nuke": "run-s clean && rimraf node_modules",
		"test": "vitest run",
		"typecheck": "tsc",
		"verify": "npm-run-all clean -p build typecheck coverage depcheck",
		"watch": "vitest",
		"w": "pnpm watch"
	},
	"devDependencies": {
		"@types/node": "^24.12.2",
		"@vitest/coverage-v8": "^5.0.0",
		"depcheck": "^1.4.7",
		"npm-run-all2": "^9.0.0",
		"rimraf": "^6.0.1",
		"tsdown": "^0.23.0",
		"typescript": "^7.0.0",
		"vitest": "^5.0.0"
	},
	"engines": {
		"node": ">= 20"
	}
}
